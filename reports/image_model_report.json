{
  "task": "binary synthetic-face classification on face crops (1 = fake, 0 = real)",
  "base_model": "google/vit-base-patch16-224-in21k",
  "datasets": {
    "faces140k": "TheKernel01/140k-Real-and-Fake-Faces (real: FFHQ, fake: StyleGAN); one parquet shard per split",
    "dff_train": "OpenRL/DeepFakeFace identity folders 10-29 (real: IMDB-WIKI; fake: SD inpainting, InsightFace swap)",
    "dff_test": "OpenRL/DeepFakeFace identity folders 00-03, 1,000 images per source; people never seen in training (real: IMDB-WIKI; fake: SD inpainting, InsightFace swap, SD text-to-image)"
  },
  "generators_seen_in_training": [
    "StyleGAN",
    "inpainting",
    "insight"
  ],
  "preprocessing": {
    "face_detector": "OpenCV YuNet 2023mar",
    "crop_margin": 1.4,
    "crop_size": 224,
    "low_res_eval_side": 64,
    "train_augmentation": "random resized crop 0.85-1.0, horizontal flip, JPEG q55-95 (p=0.5), downscale 56-160px (p=0.3)"
  },
