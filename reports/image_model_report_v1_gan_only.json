{
  "task": "binary synthetic-face classification on face crops (1 = fake, 0 = real)",
  "base_model": "google/vit-base-patch16-224-in21k",
  "datasets": {
    "train_and_in_domain_test": "TheKernel01/140k-Real-and-Fake-Faces (real: FFHQ, fake: StyleGAN); one parquet shard per split",
    "out_of_domain_test": "OpenRL/DeepFakeFace, 1,000 images per source from the same identity folders (real: IMDB-WIKI; fake: SD inpainting, InsightFace swap, SD text-to-image)"
  },
  "preprocessing": {
    "face_detector": "OpenCV YuNet 2023mar",
    "crop_margin": 1.4,
    "crop_size": 224,
    "low_res_eval_side": 64,
    "train_augmentation": "random resized crop 0.85-1.0, horizontal flip, JPEG q55-95 (p=0.5), downscale 56-160px (p=0.3)"
  },
  "no_face_detected": {
    "faces140k": {
      "train": 0,
      "val": 0,
      "test": 0
    },
    "dff": {
      "wiki": 13,
      "inpainting": 15,
      "insight": 19,
      "text2img": 13
    }
  },
  "split": {
    "seed": 42,
    "train": 16667,
    "val": 1000,
    "test": 5000
  },
  "hyperparameters": {
    "epochs": 2,
    "batch_size": 32,
    "learning_rate": 3e-05,
    "weight_decay": 0.05
  },
