# Model locations: a local folder from training/ or a Hugging Face Hub model id.
TEXT_MODEL=models/text-distilbert-welfake
IMAGE_MODEL=models/image-vit-faces

# Video sampling
VIDEO_SAMPLE_SECONDS=0.5
VIDEO_MAX_FRAMES=48

# Optional LLM summaries. Leave blank to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=26214400
UPLOAD_DIR=backend/temp
